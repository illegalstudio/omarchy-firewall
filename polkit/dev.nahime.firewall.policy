<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">

<!--
  Polkit action for the nahime.firewall Omarchy plugin.

  allow_active is auth_admin, not auth_admin_keep: auth_admin_keep would cache
  the authorisation for a few minutes, so only the first change in a burst would
  ask for the password. Every firewall change is meant to be authorised on its
  own, so the caching variant is deliberately not used here.

  allow_inactive and allow_any are "no": a firewall change has to come from the
  session actually sitting at the machine, never from a background or remote one.

  The exec.path annotation is what binds this action to pkexec, and it names the
  root-owned installed copy of the helper. The copy inside the plugin directory
  under ~/.config is user-writable and is never the thing that runs as root.
-->
<policyconfig>

  <vendor>nahime.firewall</vendor>
  <vendor_url>https://github.com/nahime/omarchy-firewall</vendor_url>

  <action id="dev.nahime.firewall.manage">
    <description>Manage the firewall</description>
    <description xml:lang="it">Gestisci il firewall</description>
    <message>Authentication is required to change the firewall rules</message>
    <message xml:lang="it">È richiesta l'autenticazione per modificare le regole del firewall</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/omarchy-firewall/omarchy-firewall</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
